{
  "$schema": "https://opencode.ai/config.json",
  "_comment": "Model/provider fields are generated by bin/apply_profile.py from harness.toml + profiles/. Everything else is hand-written and preserved across `make profile`.",
  "default_agent": "plan",
  "theme": "opencode",
  "autoupdate": true,
  "share": "disabled",
  "instructions": [
    "AGENTS.md",
    ".opencode/rules/*.md"
  ],
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "skill": {
      "*": "allow"
    },
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "jq *": "allow",
      "diff *": "allow",
      "tree *": "allow",
      "which *": "allow",
      "make test": "allow",
      "make lint": "allow",
      "make types": "allow",
      "make agents": "allow",
      "make context": "allow",
      "make evals": "allow",
      "make check": "allow",
      "make *": "ask",
      "uv run pytest*": "allow",
      "uv run ruff*": "allow",
      "uv run mypy*": "allow",
      "uv run python bin/context_budget.py*": "allow",
      "uv run python bin/lint_agents.py*": "allow",
      "uv run python evals/runner.py": "allow",
      "uv run *": "ask",
      "pytest *": "allow",
      "ruff *": "allow",
      "mypy *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git add *": "allow",
      "git stash*": "allow",
      "git blame*": "allow",
      "git commit*": "ask",
      "git checkout -- *": "ask",
      "git push*": "allow",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git remote *": "deny",
      "python *": "ask",
      "python3 *": "ask",
      "node *": "ask",
      "bash *": "ask",
      "sh *": "ask",
      "eval *": "deny",
      "* | sh": "deny",
      "* | bash": "deny",
      "curl *": "ask",
      "wget *": "deny",
      "pip install*": "ask",
      "uv add *": "ask",
      "npm i*": "ask",
      "npm install*": "ask",
      "rm *": "deny",
      "sudo *": "deny",
      "chmod *": "ask",
      "kill *": "ask",
      "docker *": "ask",
      "env": "deny",
      "printenv*": "deny",
      "set": "deny",
      "cat .env*": "deny",
      "cat *credentials*": "deny",
      "cat *~/.ssh*": "deny",
      "cat *~/.aws*": "deny",
      "cat *.pem": "deny",
      "make evals-accept*": "deny"
    }
  },
  "agent": {
    "plan": {
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "ls *": "allow",
          "cat *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "find *": "allow",
          "git log*": "allow",
          "git diff*": "allow"
        }
      },
      "model": "openrouter/deepseek/deepseek-flash"
    },
    "build": {
      "mode": "primary",
      "model": "openrouter/deepseek/deepseek-flash"
    },
    "critic": {
      "mode": "subagent",
      "description": "Adversarial reviewer. Hunts silent regressions in a diff. Never edits, never proposes fixes.",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "cat *": "allow",
          "rg *": "allow",
          "make test": "allow",
          "make evals": "allow"
        }
      },
      "model": "openrouter/deepseek/deepseek-flash"
    },
    "scribe": {
      "mode": "subagent",
      "description": "Mechanical documentation: changelogs, docstrings, README tables. No logic changes.",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "deny",
          "make lint": "allow",
          "git diff*": "allow"
        }
      },
      "model": "openrouter/deepseek/deepseek-flash"
    }
  },
  "command": {
    "check": {
      "template": "Run `make check`. If it fails, fix the smallest thing that makes it pass, then re-run. Do not edit evals/snapshots/ or raise a budget to pass. Report each fix in one line."
    },
    "review": {
      "template": "Run `git diff` against the base branch, then hand the diff to the @critic subagent. Report the critic's findings verbatim, then state which you agree with and which you don't, with reasons."
    },
    "handoff": {
      "template": "Follow skills/ship/SKILL.md. Produce the handover block and stop. Do not commit."
    },
    "context": {
      "template": "Run `make context`. If the always-on budget is exceeded, propose what to cut \u2014 moving a procedure from AGENTS.md into a skill is almost always the answer. Do not raise the budget without saying why in the same message."
    }
  },
  "mcp": {},
  "tools": {
    "todowrite": true,
    "todoread": true
  },
  "_generated_by_apply_profile": {
    "profile": "budget",
    "roles": {
      "plan": "deepseek/deepseek-flash",
      "build": "deepseek/deepseek-flash",
      "review": "deepseek/deepseek-flash",
      "scribe": "deepseek/deepseek-flash",
      "judge": "deepseek/deepseek-flash",
      "small": "deepseek/deepseek-flash"
    },
    "note": "Generated. Edit harness.toml or profiles/, then `make profile`."
  },
  "model": "openrouter/deepseek/deepseek-flash",
  "small_model": "openrouter/deepseek/deepseek-flash",
  "provider": {
    "openrouter": {
      "models": {
        "deepseek/deepseek-flash": {
          "options": {
            "provider": {
              "sort": "price",
              "allow_fallbacks": true,
              "require_parameters": true,
              "data_collection": "deny"
            },
            "transforms": []
          }
        }
      }
    }
  }
}

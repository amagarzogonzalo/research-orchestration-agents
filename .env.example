# Local configuration (git-ignored — do not commit)
# Free-tier LLM keys shared with the digest-agent project (same providers).

# --- Free LLM providers (used by discovery + the FallbackRouter) ---
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# --- Supabase Postgres (LangGraph checkpointer + store; session pooler :5432) ---
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.example.supabase.co:5432/postgres?sslmode=require

# --- Scholarly search ---
OPENALEX_MAILTO=alejandroalex.mg@gmail.com
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=alejandroalex.mg@gmail.com
UNPAYWALL_EMAIL=                 # required for Unpaywall OA lookup; must be a REAL address
                                 # (the API rejects placeholders). Leave blank to skip.
JINA_API_KEY=                    # optional; raises Jina Reader above the keyless tier

# --- General web search (fallback breadth after the scholarly set) ---
# Wikipedia needs no key and is always on. Google CSE needs both values;
# without them the adapter is skipped. NOTE: Google flags CSE as unavailable
# for new customers with discontinuation Jan 1, 2027 — if no CX engine can be
# created, use Serper instead (same Google results, one-time 2.5k free credit).
# GOOGLE_API_KEY=
# GOOGLE_CX_ENGINE=

# --- Observability (no-op unless set) ---
OTEL_TRACES_EXPORTER=
OTEL_METRICS_EXPORTER=none
OTEL_SERVICE_NAME=knowledge-engine

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

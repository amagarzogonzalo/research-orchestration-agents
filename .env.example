# Local configuration (git-ignored — do not commit)
# Free-tier LLM keys shared with the digest-agent project (same providers).

# --- Free LLM providers (used by discovery + the FallbackRouter) ---
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# --- Supabase Postgres (LangGraph checkpointer + store; session pooler :5432) ---
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.example.supabase.co:5432/postgres?sslmode=require

# --- Scholarly search ---
OPENALEX_MAILTO=you@example.com
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=you@example.com
UNPAYWALL_EMAIL=                 # required for Unpaywall OA lookup; must be a REAL address
                                 # (the API rejects placeholders). Leave blank to skip.
JINA_API_KEY=                    # optional; raises Jina Reader above the keyless tier

# --- Observability (no-op unless set) ---
OTEL_TRACES_EXPORTER=
OTEL_METRICS_EXPORTER=none
OTEL_SERVICE_NAME=knowledge-engine

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
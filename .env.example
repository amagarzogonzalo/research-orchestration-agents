# Local configuration (git-ignored — do not commit)
# Free-tier LLM keys shared with the digest-agent project (same providers).

# --- Free LLM providers (used by discovery + the FallbackRouter) ---
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# --- Supabase Postgres (LangGraph checkpointer + store; session pooler :5432) ---
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.example.supabase.co:5432/postgres?sslmode=require
# Cutover switches (env-driven; code defaults stay file/memory/local):
#   CHECKPOINTER_KIND=postgres   STORE_KIND=postgres   ARTIFACT_STORE_KIND=supabase
#   BODY_STORE_KIND=supabase     (follows ARTIFACT automatically when unset)
#   WIKI_STORE_KIND=supabase     (LLM wiki mirror; bucket "wiki" created on demand)
# Cloud artifacts/bodies/wiki live in Storage buckets; threads survive redeploys.
# Rollback: unset the switches (or set file/local) — migrate_checkpoints never
# deletes source files, so the cold backup remains on disk.

# --- Supabase Storage (ArtifactStorePort + BodyStoragePort + WikiIngestPort) ---
# SUPABASE_URL / SUPABASE_SECRET_KEY below; buckets (articles, sources, bodies,
# wiki) are created on demand by the adapters.

# Deploy posture (Render Free): WEB_CONCURRENCY=1 (512MB RAM desk math),
# browser automation NOT installed in prod (Chromium = OOM).
# LANGGRAPH_STRICT_MSGPACK=true: safe since our channel types are allow-listed
# (store/file_checkpointer.py ALLOWED_CHANNEL_SERDE_TYPES).

# --- Scholarly search ---
OPENALEX_MAILTO=you@example.com
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=you@example.com
UNPAYWALL_EMAIL=                 # required for Unpaywall OA lookup; must be a REAL address
                                 # (the API rejects placeholders). Leave blank to skip.
JINA_API_KEY=                    # optional; raises Jina Reader above the keyless tier

# --- General web search (fallback breadth after the scholarly set) ---
# Wikipedia is keyless and always on. The general-web chain runs sequentially
# and is cached on disk (repeat queries spend no quota): DuckDuckGo (keyless)
# first, then Tavily, then Exa, then Serper (independent vendor family: a DDG
# bot-wall plus one vendor outage cannot kill the web tier). Each joins only
# when its key is set and is guarded by a persisted monthly quota ledger (a
# 429/402-type reply marks the month exhausted and the chain skips it until
# it refills).
TAVILY_API_KEY=                  # 1,000 free search credits/month, no card (basic depth = 1 credit)
EXA_API_KEY=                     # $10 free credit/month, resets on the 1st, no card
SERPER_API_KEY=                  # 2,500 free searches/month (Google-grade), no card

# --- Observability (no-op unless set) ---
OTEL_TRACES_EXPORTER=
OTEL_METRICS_EXPORTER=none
OTEL_SERVICE_NAME=knowledge-engine
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Supabase (Postgres + Storage) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

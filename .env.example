# --- Runtime core ---
PYTHON_VERSION=3.12

# Zero-cost provider base URLs (free tiers only; no paid LLM tiers).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Qdrant ---
QDRANT_URL=http://localhost:6333

# --- Scholarly search (OpenAlex 100k free credits; per-ID/DOI lookups free) ---
OPENALEX_MAILTO=your-email@example.com
SEMANTIC_SCHOLAR_API_KEY=        # optional; public tier is keyless
CROSSREF_MAILTO=your-email@example.com
UNPAYWALL_EMAIL=                 # required for Unpaywall OA lookup; must be a REAL address
                                 # (the API rejects placeholders with 422). Leave blank to skip.
JINA_API_KEY=                    # optional; raises Jina Reader above the keyless ~20 RPM tier

# --- Observability: point OTLP export at a free self-hosted sink or JSONL file ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_SERVICE_NAME=knowledge-engine

# LLM API keys (all free-tier)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
